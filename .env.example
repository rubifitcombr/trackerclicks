# ── Servidor ────────────────────────────────────────────
PORT=3000

# ── Banco de dados (Supabase/Railway: use DATABASE_URL) ──
# Opção A — Supabase ou Railway (recomendado para Vercel):
DATABASE_URL=postgresql://postgres:[SENHA]@db.[REF].supabase.co:5432/postgres

# Opção B — variáveis individuais (Hostinger/local):
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=sua_senha_aqui
# DB_NAME=vyria_tracker

# ── Autenticação do painel e API de métricas ─────────────
# Acesse /painel/cliques e /api/metricas/cliques com estas credenciais
PAINEL_USER=vyria
PAINEL_PASS=tracker@2025

# ── Encurtador de links ───────────────────────────────────
# Domínio personalizado para URLs curtas (sem barra no final)
SHORT_BASE_URL=https://seu-dominio.com.br

# ── WhatsApp padrão do gerador de links ──────────────────
WHATSAPP_NUMBER=
